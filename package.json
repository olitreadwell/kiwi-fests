{
  "name": "aotearoa-festivals",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Aotearoa Festivals: open directory of NZ music festivals with dataset, scrapers, OpenAPI API, website and self-improving loops.",
  "engines": {
    "node": ">=22.22.2"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "setup": "node scripts/setup.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test a11y",
    "perf": "pnpm dlx @lhci/cli@latest autorun",
    "smoke": "bash scripts/smoke.sh",
    "check:links": "node scripts/check-internal-links.mjs",
    "check:external-links": "node scripts/check-external-links.mjs",
    "audit": "npm audit",
    "test:setup": "node --test scripts/setup.test.mjs",
    "check": "npm run build:snapshot && npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run test:setup && npm run build && npm run smoke && npm run test:e2e && npm run check:links && npm run check:external-links",
    "prepare": "husky",
    "build:snapshot": "node scripts/build-snapshot.mjs",
    "scrape": "node --env-file-if-exists=.env.local --import tsx scripts/run-scrapers.ts",
    "scrape:apply": "node --env-file-if-exists=.env.local --import tsx scripts/run-scrapers.ts --apply",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env.local scripts/seed.mjs",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:snapshot": "node --env-file-if-exists=.env.local scripts/export-snapshot.mjs",
    "contract": "node scripts/contract-test.mjs"
  },
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slot": "1.3.3",
    "better-auth": "1.7.1",
    "better-sqlite3": "13.0.3",
    "cheerio": "1.2.0",
    "drizzle-orm": "0.45.2",
    "feed": "6.0.0",
    "fuse.js": "7.5.0",
    "lucide-react": "1.34.0",
    "next": "16.3.2",
    "nodemailer": "9.0.5",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "robots-parser": "3.0.1",
    "type-fest": "5.8.0",
    "zod": "4.4.3",
    "zod-openapi": "6.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.3.0",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.2",
    "eslint-plugin-jsdoc": "64.2.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "vitest-axe": "0.1.0"
  }
}
