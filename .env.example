# Copy to .env and fill in real values. Never commit real keys.

# Server
PORT=3000
LOG_LEVEL=info

# Dataset directory
# Public base URL, used by feeds, sitemap, RSS and metadata.
NEXT_PUBLIC_SITE_URL=https://aotearoa-festivals.vercel.app
# GitHub repo "<owner>/<repo>" for community add/fix/review issue links.
NEXT_PUBLIC_GH_REPO=olitreadwell/kiwi-fests
# Postgres connection string. Empty = snapshot mode (serves src/data/snapshot.json).
DATABASE_URL=
# Vercel Cron guard for /api/cron/refresh. Generate one: openssl rand -hex 32
CRON_SECRET=
# Comma-separated scraper source ids to skip in the daily refresh.
DISABLED_SOURCES=
# Optional email subscribe/unsubscribe module (off by default).
EMAIL_SUBSCRIBE_ENABLED=
# github-pages static export mode (experimental): set to "export" when NEXT_OUTPUT_MODE=export.
NEXT_OUTPUT_MODE=

# Observability (off by default)
SENTRY_DSN=

# CORS for public /api routes. Empty means allow any origin.
CORS_ORIGIN=

# Rate limiting for /api routes: per-IP in-memory fixed window.
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# Passwordless auth (Better Auth, email OTP). AUTH_SECRET is required in
# production; dev falls back to an ephemeral secret. SMTP is shared with
# the contact form — without it codes are logged to the server console.
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_EMAIL_FROM=auth@localhost
AUTH_DB_PATH=data/auth.db
AUTH_TRUSTED_ORIGINS=
